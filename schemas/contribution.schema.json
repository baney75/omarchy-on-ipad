{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baney75.github.io/omarchy-on-ipad/schemas/contribution.schema.json",
  "title": "Omarchy on iPad contribution record",
  "type": "object",
  "required": ["id","status","contributor","agent","device","workstream","claim","evidence","safety","recorded_at"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type":"string"},
    "id": {"type":"string","pattern":"^[a-z0-9-]{3,80}$"},
    "status": {"enum":["submitted","verified_offline","verified_physical","rejected"]},
    "contributor": {"type":"string","pattern":"^[A-Za-z0-9-]{1,39}$"},
    "agent": {"type":"string","minLength":1,"maxLength":120},
    "device": {"type":"object","required":["model","board","os_build"],"additionalProperties":false,"properties":{"model":{"type":"string","pattern":"^iPad[0-9]+,[0-9]+$"},"board":{"type":"string","pattern":"^[A-Z][0-9]{3,4}AP$"},"os_build":{"type":"string","pattern":"^[0-9]{2}[A-Z][0-9A-Za-z]+$"}}},
    "workstream": {"type":"string","pattern":"^[a-z0-9-]+$"},
    "claim": {"type":"string","minLength":20,"maxLength":1000},
    "evidence": {"type":"array","minItems":1,"items":{"type":"object","required":["kind","path","sha256"],"additionalProperties":false,"properties":{"kind":{"enum":["command-output","source-citation","screenshot","test-report"]},"path":{"type":"string","pattern":"^(contributions|docs)/[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "safety": {"type":"object","required":["read_only","malformed_input","storage_write","reboot_or_recovery"],"additionalProperties":false,"properties":{"read_only":{"type":"boolean"},"malformed_input":{"const":false},"storage_write":{"const":false},"reboot_or_recovery":{"const":false}}},
    "recorded_at": {"type":"string","format":"date-time"}
  }
}
